# Copy this file to .env and fill in values as needed. .env is gitignored;
# this file is documentation only and should not contain real secrets.

# OpenWeatherMap API key. Only required for live integration tests
# (MOCK_EXTERNAL=false). Leave empty for normal mocked test runs.
OPENWEATHER_KEY=

# Mock backend base URL (json-server started via scripts/start-mock-backend.js).
API_BASE_URL=http://localhost:4000/api

# Demo frontend base URL that Cypress visits.
BASE_URL=http://localhost:3000

# true (default) uses fixtures for external weather API calls; false makes
# live calls to OpenWeatherMap / Open-Meteo (requires OPENWEATHER_KEY).
MOCK_EXTERNAL=true
